{
  "_note": "Pathfinder Pawns' rows, sort and views for build.js (ootv-claude GAME-TEMPLATES.md §2.3-2.4); from template-pathfinder-pawns-card.html / -search.html, with the empty notes search dropped (§1.7 #9), name searched as Creature (not shown: it mostly repeats the title in lower case; the user 2026-10-23) and printing quantity as Count in set (§1.7 #20), and the Class row's broken label fixed (§1.7 #24)",
  "sort": {"group": null, "first": []},
  "headers": ["type"],
  "searchdrop": ["notes"],
  "searchadd": [{"key": "name", "after": "title", "search": {"type": "text"}},
                {"key": "printing.quantity", "after": "printing.number", "search": {"type": "numeric", "advanced": true}}],
  "fieldlabels": {"name": {"label": "Creature", "short": "Creature"},
                  "quantity": {"label": "Count in set", "short": "Count in set"}},
  "rows": {
    "card": [
      {"fields": ["title"], "when": "always"},
      {"fields": ["sourcetype"]},
      {"fields": ["type"]},
      {"fields": ["subtype"]},
      {"fields": ["alignment"]},
      {"fields": ["class"]},
      {"fields": ["race"]},
      {"fields": ["size"]},
      {"fields": ["perception"]},
      {"fields": ["disable_device"]},
      {"fields": ["sources"]},
      {"fields": ["nethys"]},
      {"fields": ["notes"]}
    ],
    "printing": [
      {"fields": ["set"]},
      {"fields": ["rarity"]},
      {"fields": ["quantity"]},
      {"fields": ["flavor"]},
      {"fields": ["artist"]},
      {"fields": ["number"]}
    ],
    "detail": [
      {"fields": ["sourcetype"], "wrap": "iconic", "label": false},
      {"fields": ["alignment", "size", "type", "subtype"], "wrap": "iconic", "label": false, "when": "alignment"},
      {"fields": ["perception"], "wrap": "iconic"},
      {"fields": ["disable_device"], "wrap": "iconic"},
      {"fields": ["text"]}
    ]
  }
}
