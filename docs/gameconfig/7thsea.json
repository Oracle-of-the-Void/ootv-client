{
  "_note": "7th Sea's rows, sort and views for build.js (ootv-claude GAME-TEMPLATES.md §2.3-2.4); from template-7thsea-card.html / -search.html, with the empty notes search dropped (§1.7 #9), foil shown and searchable (§1.7 #22), and Cancel shown on cards with no Cost (36 cards never showed it)",
  "sort": {"group": null, "first": []},
  "headers": ["type"],
  "searchdrop": ["notes"],
  "searchadd": [{"key": "printing.foil", "after": "printing.number", "search": {"type": "exists", "advanced": true}}],
  "fieldlabels": {"foil": {"label": "Foil", "short": "Foil"}},
  "rows": {
    "card": [
      {"fields": ["title"], "when": "always"},
      {"fields": ["type"]},
      {"fields": ["cost", "costtype", "cancel", "canceltype"], "seps": [" ", " / ", " "], "labelfields": ["cost", "cancel"],
       "wrap": "iconic 7siconic", "when": "all",
       "else": {"fields": ["cost", "costtype"], "labelfields": ["cost", "cancel"], "wrap": "iconic 7siconic", "when": "cost",
                "else": {"fields": ["cancel", "canceltype"], "labelfields": ["cancel"], "wrap": "iconic 7siconic", "when": "cancel"}}},
      {"fields": ["cannon", "sailing", "adventuring", "influence", "swashbuckling"], "labelfields": ["prod"],
       "wraps": ["iconic 7siconic", "iconic 7siconic", "iconic 7siconic", "iconic 7siconic", "iconic 7siconic"], "suffix": " "},
      {"fields": ["movecost"], "wrap": "iconic 7siconic"},
      {"fields": ["startingwealth"], "wrap": "iconic 7siconic"},
      {"fields": ["attack", "parry"], "sep": "/", "wrap": "iconic 7siconic", "when": "attack"},
      {"fields": ["faction"]},
      {"fields": ["affiliation"]},
      {"fields": ["traits"], "join": " &#149; "},
      {"fields": ["tocomplete"]},
      {"fields": ["text"]},
      {"fields": ["erratum"]},
      {"fields": ["notes"]}
    ],
    "printing": [
      {"fields": ["set"]},
      {"fields": ["rarity"]},
      {"fields": ["foil"]},
      {"fields": ["flavor"]},
      {"fields": ["artist"]},
      {"fields": ["number"]}
    ],
    "detail": [
      {"fields": ["type"], "wrap": "iconic 7siconic"},
      {"fields": ["cost", "costtype", "cancel", "canceltype"], "seps": [" ", " / ", " "], "labelfields": ["cost", "cancel"],
       "wrap": "iconic 7siconic", "when": "all",
       "else": {"fields": ["cost", "costtype"], "labelfields": ["cost", "cancel"], "wrap": "iconic 7siconic", "when": "cost",
                "else": {"fields": ["cancel", "canceltype"], "labelfields": ["cancel"], "wrap": "iconic 7siconic", "when": "cancel"}}},
      {"fields": ["cannon", "sailing", "adventuring", "influence", "swashbuckling"], "labelfields": ["prod"],
       "wraps": ["iconic 7siconic", "iconic 7siconic", "iconic 7siconic", "iconic 7siconic", "iconic 7siconic"], "suffix": " "},
      {"fields": ["movecost"], "wrap": "iconic 7siconic"},
      {"fields": ["startingwealth"], "wrap": "iconic 7siconic"},
      {"fields": ["attack", "parry"], "sep": "/", "wrap": "iconic 7siconic", "when": "attack"},
      {"fields": ["faction"]},
      {"fields": ["affiliation"]},
      {"fields": ["traits"], "join": " &#149; "},
      {"fields": ["tocomplete"]},
      {"fields": ["text"]}
    ]
  }
}
