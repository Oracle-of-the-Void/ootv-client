{
  "_note": "LBS's rows, sort and views for build.js (ootv-claude GAME-TEMPLATES.md §2.3-2.4); from template-lbs-card.html / -search.html, with artist and flavor searched on the printing (§1.7 #8), the empty keywords row dropped (LBS has no keywords), and city sections (strength, no ka) shown as Strength/Water, the user 2026-10-23",
  "info": {"background": "res/background-lbs.jpg"},
  "sort": {"group": "deck", "first": ["Pre-Game"]},
  "headers": ["deck", "type"],
  "searchrename": {"artist": "printing.artist", "flavor": "printing.flavor"},
  "rows": {
    "card": [
      {"fields": ["title"], "when": "always"},
      {"fields": ["type"]},
      {"fields": ["strength", "ka"], "wraps": ["iconic strength", "iconic ka"], "when": "ka",
       "else": {"fields": ["strength", "water"], "wraps": ["iconic strength", "iconic smwater"], "when": "strength"}},
      {"fields": ["water", "copper", "influence"], "wraps": ["iconic smwater", "iconic smcopper", "iconic sminf"],
       "when": "influence",
       "else": {"fields": ["copper"], "wraps": ["iconic smcopper"]}},
      {"fields": ["city"], "wraps": ["iconic smcity"]},
      {"fields": ["faction"]},
      {"fields": ["text"]},
      {"fields": ["fate"]},
      {"fields": ["deck"]},
      {"fields": ["notes"]}
    ],
    "printing": [
      {"fields": ["set"]},
      {"fields": ["rarity"]},
      {"fields": ["flavor"]},
      {"fields": ["artist"]},
      {"fields": ["number"]}
    ],
    "detail": [
      {"fields": ["type"], "label": false},
      {"fields": ["strength", "ka"], "wraps": ["iconic smstrength", "iconic smka"], "suffix": true, "label": false, "when": "ka",
       "else": {"fields": ["strength", "water"], "wraps": ["iconic smstrength", "iconic smwater"], "suffix": true,
                "label": false, "when": "strength"}},
      {"fields": ["water", "copper", "influence"], "wraps": ["iconic smwater", "iconic smcopper", "iconic sminfluence"],
       "suffix": true, "label": false, "when": "influence",
       "else": {"fields": ["water", "copper"], "wraps": ["iconic smwater", "iconic smcopper"], "suffix": true,
                "label": false, "when": "copper"}},
      {"fields": ["city"], "wraps": ["iconic smcity"], "suffix": true, "label": false},
      {"fields": ["text"], "label": false},
      {"fields": ["fate"], "wraps": ["iconic smfate"], "suffix": true, "label": false}
    ]
  }
}
