{
  "_note": "Warlord's rows, sort and views for build.js (ootv-claude GAME-TEMPLATES.md §2.3-2.4); from template-warlord-card.html / -search.html, with editions shown as Formats in place of the dead formats row (§1.7 #25)",
  "sort": {"group": null, "first": []},
  "headers": ["type"],
  "rows": {
    "card": [
      {"fields": ["title"], "when": "always"},
      {"fields": ["type"], "wrap": "iconic 7siconic"},
      {"fields": ["level", "class"], "labelfields": ["level"]},
      {"fields": ["alignment"]},
      {"fields": ["attack", "armorClass", "skill", "hitPoints"], "label": "Stats", "valuelabels": true, "sep": " &#149; "},
      {"fields": ["faction", "traits", "feats"], "labelfields": ["traits"], "concat": true, "join": " &#149; "},
      {"fields": ["text"]},
      {"fields": ["editions"], "join": " &#149; "},
      {"fields": ["challengeLord"]},
      {"fields": ["erratum"]}
    ],
    "printing": [
      {"fields": ["set"]},
      {"fields": ["rarity"]},
      {"fields": ["flavorTraits"], "join": " &#149; "},
      {"fields": ["flavor"]},
      {"fields": ["artist"]},
      {"fields": ["number"]}
    ],
    "detail": [
      {"fields": ["type"], "wrap": "iconic 7siconic"},
      {"fields": ["level", "class"], "labelfields": ["level"]},
      {"fields": ["alignment"]},
      {"fields": ["attack", "armorClass", "skill", "hitPoints"], "label": "Stats", "valuelabels": true, "sep": " &#149; "},
      {"fields": ["faction", "traits", "feats"], "labelfields": ["traits"], "concat": true, "join": " &#149; "},
      {"fields": ["text"]}
    ]
  }
}
